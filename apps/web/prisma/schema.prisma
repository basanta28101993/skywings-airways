generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Flight {
  id             String    @id @default(cuid())
  flightNumber   String    @unique
  airline        String
  fromCode       String
  fromCity       String
  toCode         String
  toCity         String
  departureTime  DateTime
  arrivalTime    DateTime
  basePrice      Decimal   @db.Decimal(10, 2)
  currency       String    @default("INR")
  seatsAvailable Int
  aircraft       String
  createdAt      DateTime  @default(now())
  bookings       Booking[]

  @@index([fromCode, toCode, departureTime])
}

model Booking {
  id                 String   @id @default(cuid())
  pnr                String   @unique
  flightId           String
  flight             Flight   @relation(fields: [flightId], references: [id])
  passengerName      String
  passengerEmail     String
  passengerPhone     String
  totalPrice         Decimal  @db.Decimal(10, 2)
  currency           String   @default("INR")
  status             String   @default("CONFIRMED")
  createdAt          DateTime @default(now())
  ancillaryPurchases AncillaryPurchase[]

  @@index([passengerEmail])
  @@index([pnr])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  locale    String   @default("in")
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════
// DAILY ROUTE METRICS (Central Data Platform - Offline Store)
// ═══════════════════════════════════════════════════════════
model DailyRouteMetrics {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  route           String   // e.g., "DEL-BOM"
  fromCode        String
  toCode          String
  bookings        Int
  revenue         Decimal  @db.Decimal(12, 2)
  avgFare         Decimal  @db.Decimal(10, 2)
  cancellations   Int      @default(0)
  loadFactor      Float
  isWeekend       Boolean
  isHoliday       Boolean  @default(false)
  holidayName     String?
  weatherScore    Float?
  competitorFare  Decimal? @db.Decimal(10, 2)
  promotionActive Boolean  @default(false)

  @@unique([date, route])
  @@index([route])
  @@index([date])
  @@index([route, date])
  @@map("daily_route_metrics")
}

model Transaction {
  id             String   @id @default(cuid())
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("INR")
  paymentMethod  String   // e.g., "card", "upi", "netbanking"
  ipCountry      String
  billingCountry String
  deviceType     String   // e.g., "web", "ios", "android"
  bookingHour    Int      // 0-23
  isFraud        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([isFraud])
}

model AncillaryItem {
  id        String              @id @default(cuid())
  name      String
  category  String              // "baggage", "meal", "lounge", "insurance"
  price     Decimal             @db.Decimal(10, 2)
  purchases AncillaryPurchase[]
}

model AncillaryPurchase {
  id         String        @id @default(cuid())
  bookingId  String
  booking    Booking       @relation(fields: [bookingId], references: [id])
  itemId     String
  item       AncillaryItem @relation(fields: [itemId], references: [id])
  quantity   Int           @default(1)
  totalPrice Decimal       @db.Decimal(10, 2)
  createdAt  DateTime      @default(now())

  @@index([bookingId])
  @@index([itemId])
}
